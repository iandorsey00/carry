{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "id", "revision", "title", "language", "license", "lessons"],
      "properties": {
        "format": { "const": "education-course/0.1" },
        "id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revision" },
        "title": { "$ref": "#/$defs/text" },
        "language": { "type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$" },
        "license": { "$ref": "#/$defs/text" },
        "objectives": { "type": "array", "items": { "$ref": "#/$defs/objective" } },
        "banks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\.(json|yaml|yml)$" }
        },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "cards"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "$ref": "#/$defs/text" },
              "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/card" } }
            }
          }
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "blocks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "objectives": { "$ref": "#/$defs/ids" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/markdown" },
              { "$ref": "#/$defs/media" },
              { "$ref": "#/$defs/questions" },
              { "$ref": "#/$defs/widget" }
            ]
          }
        }
      }
    },
    "markdownPath": { "type": "string", "pattern": "\\.md$" },
    "markdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "src"],
      "properties": {
        "type": { "const": "markdown" },
        "src": { "$ref": "#/$defs/markdownPath" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "src", "description"],
      "properties": {
        "type": { "const": "media" },
        "kind": { "enum": ["image", "pdf", "audio", "video"] },
        "src": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "transcript": { "$ref": "#/$defs/markdownPath" },
        "captions": { "type": "string", "pattern": "\\.vtt$" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["audio", "video"] } } },
          "then": { "required": ["transcript"] }
        },
        {
          "if": { "properties": { "kind": { "const": "video" } } },
          "then": { "required": ["captions"] }
        }
      ]
    },
    "questions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bank", "items", "mode"],
      "properties": {
        "type": { "const": "questions" },
        "bank": { "$ref": "#/$defs/id" },
        "items": { "$ref": "#/$defs/ids", "type": "array", "minItems": 1 },
        "mode": { "enum": ["knowledge-check", "practice"] },
        "shuffleOptions": { "type": "boolean" }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "widget", "version", "config", "fallback"],
      "properties": {
        "type": { "const": "widget" },
        "widget": { "type": "string", "pattern": "^[a-z][a-z0-9-]+\\.[a-z][a-z0-9.-]+$" },
        "version": { "$ref": "#/$defs/revision" },
        "config": { "type": "string", "pattern": "\\.json$" },
        "fallback": { "$ref": "#/$defs/markdownPath" }
      }
    },
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "id", "items"],
      "properties": {
        "format": { "const": "education-bank/0.1" },
        "id": { "$ref": "#/$defs/id" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "prompt", "parts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revision" },
        "prompt": { "$ref": "#/$defs/text" },
        "difficulty": { "enum": ["introductory", "developing", "challenging"] },
        "demand": { "enum": ["recognize", "recall", "apply", "explain"] },
        "objectives": { "$ref": "#/$defs/ids" },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "explanationCard": { "$ref": "#/$defs/id" },
        "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/part" } }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["single-choice", "multiple-selection", "exact-text"] },
        "hint": { "$ref": "#/$defs/text" },
        "feedback": { "$ref": "#/$defs/text" },
        "legacyId": { "$ref": "#/$defs/text" },
        "distractorGroup": { "$ref": "#/$defs/text" },
        "normalization": { "enum": ["trim", "trim-ascii-case-insensitive"] },
        "accepted": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "$ref": "#/$defs/text" }
            }
          }
        },
        "correct": { "$ref": "#/$defs/ids", "type": "array", "minItems": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "exact-text" } } },
          "then": {
            "required": ["normalization", "accepted"],
            "properties": { "options": false, "correct": false }
          },
          "else": {
            "required": ["options", "correct"],
            "properties": { "normalization": false, "accepted": false }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "single-choice" } } },
          "then": { "properties": { "correct": { "type": "array", "maxItems": 1 } } }
        }
      ]
    }
  }
}
